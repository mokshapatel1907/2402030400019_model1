<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Your Luxury Cart - LuxeGift</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #242527 0%, #2F4A61 35%, #5F8396 65%, #6F6558 85%, #BCB9AC 100%);
      min-height: 100vh;
      overflow-x: hidden;
      color: #f5f5f5;
      display: flex;
      flex-direction: column;
      padding-top: 130px;
    }

    /* Navbar */
    nav {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: 85%;
      z-index: 9999;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 20px 50px;
      border-radius: 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }

    .logo {
      font-size: 2.3rem;
      font-weight: 700;
      color: #f0e7d8;
      letter-spacing: 1px;
    }

    nav ul {
      display: flex;
      gap: 40px;
      list-style: none;
    }

    nav ul li a {
      text-decoration: none;
      color: #f5f5f5;
      font-size: 1rem;
      font-weight: 500;
      transition: 0.3s;
    }

    nav ul li a:hover {
      color: #BCB9AC;
    }

    .section-title {
      text-align: center;
      font-size: 3rem;
      margin-top: 30px;
      margin-bottom: 40px;
      color: #f1ece2;
      font-family: Georgia, serif;
    }

    /* Main Content Wrapper (Split Layout) */
    .cart-main-wrapper {
      width: 85%;
      margin: 0 auto auto;
      display: flex;
      gap: 30px;
      align-items: flex-start;
    }

    /* Left Side: Horizontal Cart Items Container */
    .items-container {
      flex: 2;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 28px;
      padding: 30px;
      display: flex;
      flex-direction: column;
      gap: 25px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    /* Horizontal Product Row */
    .cart-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 25px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cart-item-row:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .item-details-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .cart-item-row img {
      width: 90px;
      height: 90px;
      object-fit: cover;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .item-text h3 {
      font-size: 1.25rem;
      color: #f0e7d8;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .item-text p {
      font-size: 0.9rem;
      color: #cccccc;
      margin-bottom: 8px;
    }

    .item-text .price-tag {
      font-size: 1.15rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 10px;
    }

    /* Quantity Controls */
    .quantity-controls {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .qty-btn {
      width: 26px;
      height: 26px;
      border: none;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 6px;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s;
    }

    .qty-btn:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    .qty-number {
      font-size: 1rem;
      font-weight: 500;
      min-width: 15px;
      text-align: center;
    }

    /* Remove Button styling matching image */
    .remove-btn {
      padding: 8px 18px;
      border: none;
      border-radius: 8px;
      background: #e74c3c;
      color: #fff;
      cursor: pointer;
      font-weight: 500;
      font-size: 0.85rem;
      transition: 0.3s;
    }

    .remove-btn:hover {
      background: #c0392b;
      transform: scale(1.03);
    }

    /* Right Side: Order Summary Card Layout */
    .order-summary-card {
      flex: 1;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 28px;
      padding: 35px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    .order-summary-card h2 {
      text-align: center;
      font-size: 1.7rem;
      color: #f0e7d8;
      margin-bottom: 30px;
      font-weight: 600;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
      font-size: 0.95rem;
      color: #dddddd;
    }

    .summary-row.total-row {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      font-size: 1.35rem;
      font-weight: 600;
      color: #ffffff;
    }

    .checkout-btn {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(to right, #BCB9AC, #d9d4ca);
      color: #1d2731;
      font-weight: 700;
      cursor: pointer;
      font-size: 1rem;
      margin-top: 15px;
      transition: 0.3s;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .checkout-btn:hover {
      transform: scale(1.02);
    }

    .empty-msg {
      text-align: center;
      font-size: 1.2rem;
      color: #ddd;
      padding: 40px 0;
    }

    /* Footer */
    footer {
      width: 85%;
      margin: 60px auto 35px;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 28px;
      padding: 45px 40px 20px;
      color: #f1ece2;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }

    .footer-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 35px;
    }

    .footer-box h2 {
      font-size: 2rem;
      margin-bottom: 15px;
      color: #f0e7d8;
    }

    .footer-box h3 {
      margin-bottom: 18px;
      color: #ffffff;
      font-size: 1.2rem;
    }

    .footer-box p {
      color: #dddddd;
      line-height: 1.8;
      font-size: 0.95rem;
    }

    .footer-box ul {
      list-style: none;
    }

    .footer-box ul li {
      margin-bottom: 12px;
    }

    .footer-box ul li a {
      text-decoration: none;
      color: #dddddd;
      transition: 0.3s;
    }

    .footer-box ul li a:hover {
      color: #ffffff;
      padding-left: 5px;
    }

    .footer-bottom {
      margin-top: 35px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      text-align: center;
      color: #e0e0e0;
      font-size: 0.95rem;
    }

    /* Responsive adjustments */
    @media(max-width: 992px) {
      .cart-main-wrapper {
        flex-direction: column;
      }
      .items-container, .order-summary-card {
        width: 100%;
      }
    }

    @media(max-width: 768px) {
      nav {
        flex-direction: column;
        gap: 15px;
        padding: 20px;
      }
      nav ul {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .cart-item-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }
      .remove-btn {
        align-self: flex-end;
      }
    }
  </style>
</head>
<body>

  <nav>
    <div class="logo">LuxeGift</div>
    <ul>
      <li><a href="../website/web(gift).html">Home</a></li>
      <li><a href="../website/gift.html">Gifts</a></li>
      <li><a href="../website/accessories.html">Accessories</a></li>
      <li><a href="../website/flowers.html">Flowers</a></li>
      <li><a href="../website/cart.html">Cart</a></li>
      <li><a href="../website/login.html">Login</a></li>
    </ul>
  </nav>

  <h1 class="section-title">Your Luxury Cart</h1>

  <main class="cart-main-wrapper">
    
    <section class="items-container" id="itemsContainer">
      </section>

    <aside class="order-summary-card" id="summaryCard" style="display: none;">
      <h2>Order Summary</h2>
      
      <div class="summary-row">
        <span>Items</span>
        <span id="itemsCountDisplay">0</span>
      </div>
      
      <div class="summary-row">
        <span>Shipping</span>
        <span id="shippingChargeDisplay">₹199</span>
      </div>
      
      <div class="summary-row total-row">
        <span>Total</span>
        <span id="totalPriceDisplay">₹0</span>
      </div>
      
      <button class="checkout-btn"><a href="../website/gift(form).html" style="text-decoration: none; color: inherit;">Proceed To Checkout</a></button>
    </aside>

  </main>

  <footer>
    <div class="footer-container">
      <div class="footer-box">
        <h2>LuxeGift</h2>
        <p>Premium luxury gifting platform crafted for unforgettable memories and elegant surprises.</p>
      </div>
      <div class="footer-box">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="../website/web(gift).html">Home</a></li>
          <li><a href="../website/gift.html">Gifts</a></li>
          <li><a href="../website/accessories.html">Accessories</a></li>
          <li><a href="../website/flowers.html">Flowers</a></li>
          <li><a href="../website/contact.html">Contact</a></li>
        </ul>
      </div>
      <div class="footer-box">
        <h3>Customer Support</h3>
        <ul>
          <li><a href="../website/help_center.html">Help Center</a></li>
          <li><a href="../website/shipping_policy.html">Shipping Policy</a></li>
          <li><a href="../website/privacy_policy.html">Privacy Policy</a></li>
          <li><a href="../website/terms_conditions.html">Terms & Conditions</a></li>
        </ul>
      </div>
      <div class="footer-box">
        <h3>Contact Us</h3>
        <p>Email: support@luxegift.com</p>
        <p>Phone: +91 98765 43210</p>
        <p>Ahmedabad, Gujarat</p>
      </div>
    </div>
    <div class="footer-bottom">
      © 2026 LuxeGift | Luxury Online Gifting Experience
    </div>
  </footer>

  <script>
    function renderCartLayout() {
      const itemsContainer = document.getElementById("itemsContainer");
      const summaryCard = document.getElementById("summaryCard");
      const itemsCountDisplay = document.getElementById("itemsCountDisplay");
      const totalPriceDisplay = document.getElementById("totalPriceDisplay");

      let cart = JSON.parse(localStorage.getItem("cart")) || [];

      if (cart.length === 0) {
        itemsContainer.innerHTML = `<div class="empty-msg">Your shopping cart is currently empty.</div>`;
        summaryCard.style.display = "none";
        return;
      }

      itemsContainer.innerHTML = "";
      summaryCard.style.display = "block";

      let accumulatedTotal = 0;
      let totalItemCount = 0;
      const shippingFee = 199; // Standard flat-rate shipping charge matching layout screen

      cart.forEach((product, index) => {
        // Handle quantities securely (defaults to 1 if unset)
        if(!product.quantity) { product.quantity = 1; }
        
        totalItemCount += product.quantity;
        accumulatedTotal += parseInt(product.price) * product.quantity;

        itemsContainer.innerHTML += `
          <div class="cart-item-row">
            <div class="item-details-left">
              <img src="${product.image}" alt="${product.name}">
              <div class="item-text">
                <h3>${product.name}</h3>
                <p>Premium luxury selection</p>
                <div class="price-tag">₹${parseInt(product.price).toLocaleString('en-IN')}</div>
                <div class="quantity-controls">
                  <button class="qty-btn" onclick="updateQty(${index}, -1)">-</button>
                  <span class="qty-number">${product.quantity}</span>
                  <button class="qty-btn" onclick="updateQty(${index}, 1)">+</button>
                </div>
              </div>
            </div>
            <button class="remove-btn" onclick="deleteItem(${index})">Remove</button>
          </div>
        `;
      });

      // Update calculations calculations panel
      itemsCountDisplay.innerText = totalItemCount;
      const checkoutTotal = accumulatedTotal + shippingFee;
      totalPriceDisplay.innerText = "₹" + checkoutTotal.toLocaleString('en-IN');
    }

    // Controls quantity scaling counters seamlessly
    function updateQty(index, amount) {
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      if(!cart[index].quantity) { cart[index].quantity = 1; }
      
      cart[index].quantity += amount;
      
      if(cart[index].quantity <= 0) {
        cart.splice(index, 1); // Delete completely if counter drops to zero
      }
      
      localStorage.setItem("cart", JSON.stringify(cart));
      renderCartLayout();
    }

    function deleteItem(index) {
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      cart.splice(index, 1);
      localStorage.setItem("cart", JSON.stringify(cart));
      renderCartLayout();
    }

    window.onload = renderCartLayout;
  </script>
</body>
</html>
