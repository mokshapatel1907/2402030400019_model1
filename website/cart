<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>LuxeGift Cart</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

   body{
  background:
  linear-gradient(
  135deg,
  #242527 0%,
  #2F4A61 35%,
  #5F8396 65%,
  #6F6558 85%,
  #BCB9AC 100%);

  min-height:100vh;
  overflow-x:hidden;
  color:#f5f5f5;

  display:flex;
  flex-direction:column;

  padding-top:150px;
}

    body::before{
      content:'';
      position:absolute;
      width:700px;
      height:700px;
      background:rgba(188,185,172,0.12);
      border-radius:50%;
      top:-250px;
      left:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    body::after{
      content:'';
      position:absolute;
      width:650px;
      height:650px;
      background:rgba(95,131,150,0.18);
      border-radius:50%;
      bottom:-250px;
      right:-200px;
      z-index:-1;
      filter:blur(80px);
    }

   /* Navbar */

nav{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  width:85%;
  z-index:9999;

  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);

  padding:20px 50px;
  border-radius:25px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

    .logo{
      font-size:2.3rem;
      font-weight:700;
      color:#f0e7d8;
    }

    nav ul{
      display:flex;
      gap:40px;
      list-style:none;
    }

    nav ul li a{
      text-decoration:none;
      color:#f5f5f5;
      font-size:1rem;
      font-weight:500;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#BCB9AC;
    }

    /* Title */

    .cart-title{
      text-align:center;
      font-size:3rem;
      margin:50px 0;
      color:#f1ece2;
      font-family:Georgia, serif;
    }

    /* Cart Layout */

    .cart-wrapper{
      width:85%;
      margin:auto;
      display:grid;
      grid-template-columns:2fr 1fr;
      gap:30px;
      align-items:start;
    }

    /* Cart Items */

    .cart-box{
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(20px);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:30px;
      padding:25px;
      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    }

    .cart-item{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:25px 0;
      border-bottom:1px solid rgba(255,255,255,0.08);
    }

    .cart-item:last-child{
      border-bottom:none;
    }

    .left{
      display:flex;
      gap:20px;
      align-items:center;
    }

    .left img{
      width:110px;
      height:110px;
      border-radius:18px;
      object-fit:cover;
    }

    .details h2{
      font-size:1.4rem;
      margin-bottom:8px;
      color:#f0e7d8;
    }

    .details p{
      color:#dddddd;
      margin-bottom:10px;
    }

    .price{
      font-size:1.3rem;
      font-weight:600;
      color:#ffffff;
    }

    .quantity{
      display:flex;
      align-items:center;
      gap:10px;
      margin-top:12px;
    }

    .quantity button{
      width:32px;
      height:32px;
      border:none;
      border-radius:10px;
      background:rgba(255,255,255,0.12);
      color:white;
      cursor:pointer;
      font-size:1rem;
    }

    .remove-btn{
      border:none;
      padding:12px 22px;
      border-radius:14px;
      background:#ef5b5b;
      color:white;
      cursor:pointer;
      font-weight:600;
      transition:0.3s;
    }

    .remove-btn:hover{
      transform:scale(1.05);
    }

    /* Summary */

    .summary-box{
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(20px);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:30px;
      padding:30px;
      box-shadow:0 10px 30px rgba(0,0,0,0.25);
      position:sticky;
      top:30px;
    }

    .summary-box h2{
      text-align:center;
      margin-bottom:35px;
      font-size:2rem;
      color:#f0e7d8;
    }

    .summary-row{
      display:flex;
      justify-content:space-between;
      margin-bottom:25px;
      color:#e5e5e5;
      font-size:1rem;
    }

    .total{
      border-top:1px solid rgba(255,255,255,0.1);
      padding-top:25px;
      margin-top:25px;
      font-size:1.6rem;
      font-weight:600;
    }

    .checkout-btn{
      width:100%;
      margin-top:30px;
      padding:16px;
      border:none;
      border-radius:16px;
      background:linear-gradient(to right,#BCB9AC,#d9d4ca);
      color:#1d2731;
      font-size:1rem;
      font-weight:600;
      cursor:pointer;
      transition:0.3s;
    }

    .checkout-btn:hover{
      transform:scale(1.03);
    }

    /* Footer */

    footer{
      width:85%;
      margin:70px auto 35px;
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(20px);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:28px;
      padding:45px 40px 20px;
      color:#f1ece2;
      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    }

    .footer-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:35px;
    }

    .footer-box h2{
      font-size:2rem;
      margin-bottom:15px;
      color:#f0e7d8;
    }

    .footer-box h3{
      margin-bottom:18px;
      color:#ffffff;
      font-size:1.2rem;
    }

    .footer-box p{
      color:#dddddd;
      line-height:1.8;
      font-size:0.95rem;
    }

    .footer-box ul{
      list-style:none;
    }

    .footer-box ul li{
      margin-bottom:12px;
    }

    .footer-box ul li a{
      text-decoration:none;
      color:#dddddd;
      transition:0.3s;
    }

    .footer-box ul li a:hover{
      color:#ffffff;
      padding-left:5px;
    }

    .footer-bottom{
      margin-top:35px;
      padding-top:20px;
      border-top:1px solid rgba(255,255,255,0.1);
      text-align:center;
      color:#e0e0e0;
      font-size:0.95rem;
    }

    .checkout-btn a{
   text-decoration:none;
   color:#294bc8;
   font-weight:600;
   font-size:1.2rem;
}

    /* Responsive */

    @media(max-width:900px){

      .cart-wrapper{
        grid-template-columns:1fr;
      }

      nav{
        flex-direction:column;
        gap:20px;
        padding:20px;
      }

      nav ul{
        gap:18px;
        flex-wrap:wrap;
        justify-content:center;
      }

      .cart-item{
        flex-direction:column;
        gap:20px;
        align-items:flex-start;
      }

    }

  </style>

</head>

<body>

  <!-- Navbar -->

  <nav>

    <div class="logo">LuxeGift</div>

    <ul>
      <li><a href="../website/web(gift).html">Home</a></li>
      <li><a href="../website/gift.html">Gifts</a></li>
      <li><a href="../website/accessories.html">Accessories</a></li>
      <li><a href="../website/flowers.html">Flowers</a></li>
      <li><a href="../website/cart.html">Cart</a></li>
      <li><a href="../website/login.html">Login</a></li>
    </ul>

  </nav>

  <!-- Title -->

  <h1 class="cart-title">Your Luxury Cart</h1>

  <!-- Cart -->

  <section class="cart-wrapper">

    <!-- Left -->

    <div class="cart-box" id="cartContainer">

    </div>

    <!-- Right -->

    <div class="summary-box">

      <h2>Order Summary</h2>

      <div class="summary-row">
        <span>Items</span>
        <span id="itemCount">0</span>
      </div>

      <div class="summary-row">
        <span>Shipping</span>
        <span>₹199</span>
      </div>

      <div class="summary-row total">
        <span>Total</span>
        <span id="totalPrice">₹0</span>
      </div>

      <button class="checkout-btn">
   <a href="../website/gift(form).html">Proceed To Checkout</a>
</button>

    </div>

  </section>

  <!-- Footer -->

  <footer>

    <div class="footer-container">

      <div class="footer-box">

        <h2>LuxeGift</h2>

        <p>
          Premium luxury gifting platform crafted for unforgettable
          memories and elegant surprises.
        </p>

      </div>

      <div class="footer-box">

        <h3>Quick Links</h3>

        <ul>
          <li><a href="../website/web(gift).html">Home</a></li>
          <li><a href="../website/gift.html">Gifts</a></li>
          <li><a href="../website/accessories.html">Accessories</a></li>
          <li><a href="../website/flowers.html">Flowers</a></li>
          <li><a href="../website/contact.html">Contact</a></li>
        </ul>

      </div>

      <div class="footer-box">

        <h3>Customer Support</h3>

        <ul>
        <li><a href="../website/help_center.html">Help Center</a></li>
        <li><a href="../website/shipping_policy.html">Shipping Policy</a></li>
        <li><a href="../website/privacy_policy.html">Privacy Policy</a></li>
        <li><a href="../website/terms_conditions.html">Terms & Conditions</a></li>
      </ul>

      </div>

      <div class="footer-box">

        <h3>Contact Us</h3>

        <p>Email: support@luxegift.com</p>

        <p>Phone: +91 98765 43210</p>

        <p>Ahmedabad, Gujarat</p>

      </div>

    </div>

    <div class="footer-bottom">

      © 2026 LuxeGift | Luxury Online Gifting Experience

    </div>

  </footer>

  <!-- JavaScript -->

  <script>

  const cartContainer = document.getElementById("cartContainer");

  let cart = JSON.parse(localStorage.getItem("cart")) || [];

  // Add default quantity if not available
  cart.forEach(item => {
    if(!item.quantity){
      item.quantity = 1;
    }
  });

  function displayCart(){

    cartContainer.innerHTML = "";

    let total = 0;

    cart.forEach((item,index)=>{

      let itemTotal = item.price * item.quantity;

      total += itemTotal;

      cartContainer.innerHTML += `

      <div class="cart-item">

        <div class="left">

          <img src="${item.image}">

          <div class="details">

            <h2>${item.name}</h2>

            <p>Luxury premium collection</p>

            <div class="price">₹${item.price}</div>

            <div class="quantity">

              <button onclick="decreaseQuantity(${index})">-</button>

              <span>${item.quantity}</span>

              <button onclick="increaseQuantity(${index})">+</button>

            </div>

          </div>

        </div>

        <button class="remove-btn" onclick="removeItem(${index})">
          Remove
        </button>

      </div>

      `;

    });

    // Save updated cart
    localStorage.setItem("cart", JSON.stringify(cart));

    // Update summary
    document.getElementById("itemCount").innerText =
      cart.reduce((sum,item)=> sum + item.quantity, 0);

    document.getElementById("totalPrice").innerText =
      "₹" + (total + 199);

  }

  // Increase Quantity
  function increaseQuantity(index){

    cart[index].quantity++;

    displayCart();

  }

  // Decrease Quantity
  function decreaseQuantity(index){

    if(cart[index].quantity > 1){

      cart[index].quantity--;

    } else {

      // Remove item if quantity becomes 0
      cart.splice(index,1);

    }

    displayCart();

  }

  // Remove Item
  function removeItem(index){

    cart.splice(index,1);

    displayCart();

  }

  // Initial Display
  displayCart();

</script>

</body>
</html>
