<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Contact Us - LuxeGift</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

   body{
  background:
  linear-gradient(
  135deg,
  #242527 0%,
  #2F4A61 35%,
  #5F8396 65%,
  #6F6558 85%,
  #BCB9AC 100%);

  min-height:100vh;
  overflow-x:hidden;
  color:#f5f5f5;

  display:flex;
  flex-direction:column;

  padding-top:150px;
}

    /* Background Glow */

    body::before{
      content:'';
      position:absolute;
      width:700px;
      height:700px;
      background:rgba(188,185,172,0.12);
      border-radius:50%;
      top:-250px;
      left:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    body::after{
      content:'';
      position:absolute;
      width:650px;
      height:650px;
      background:rgba(95,131,150,0.18);
      border-radius:50%;
      bottom:-250px;
      right:-200px;
      z-index:-1;
      filter:blur(80px);
    }

   /* Navbar */

nav{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  width:85%;
  z-index:9999;

  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);

  padding:20px 50px;
  border-radius:25px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

/* ADD THIS CSS (NAVBAR SEARCH STYLE) */

.search-box{
  display:flex;
  align-items:center;
  gap:10px;
}

.search-box input{

  width:260px;
  padding:12px 18px;

  border:none;
  outline:none;

  border-radius:14px;

  background:rgba(255,255,255,0.08);

  border:1px solid rgba(255,255,255,0.1);

  color:#fff;

  font-size:0.95rem;

}

.search-box input::placeholder{
  color:#ddd;
}

.search-box button{

  padding:12px 20px;

  border:none;

  border-radius:14px;

  background:linear-gradient(to right,#BCB9AC,#d9d4ca);

  color:#1d2731;

  font-weight:600;

  cursor:pointer;

}

    .logo{
      font-size:2.3rem;
      font-weight:700;
      color:#f0e7d8;
      letter-spacing:1px;
    }

    nav ul{
      display:flex;
      gap:40px;
      list-style:none;
    }

    nav ul li a{
      text-decoration:none;
      color:#f5f5f5;
      font-size:1rem;
      font-weight:500;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#BCB9AC;
    }

    /* Contact Section */

    .contact-section{
      width:85%;
      margin:60px auto;
      display:flex;
      justify-content:center;
      align-items:center;
    }

    .contact-container{
      width:100%;
      max-width:700px;
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:30px;
      padding:50px;
      box-shadow:0 10px 30px rgba(0,0,0,0.3);

      /* Animation */

      animation:slideUp 1s ease;
    }

    .contact-container h1{
      text-align:center;
      font-size:3rem;
      margin-bottom:15px;
      color:#f1ece2;
      font-family:Georgia, serif;
    }

    .contact-container p{
      text-align:center;
      color:#dddddd;
      margin-bottom:40px;
      line-height:1.8;
    }

    .form-group{
      margin-bottom:25px;
    }

    .form-group label{
      display:block;
      margin-bottom:8px;
      font-weight:500;
      color:#f5f5f5;
    }

    .form-group input,
    .form-group textarea{
      width:100%;
      padding:15px;
      border:none;
      outline:none;
      border-radius:15px;
      background:rgba(255,255,255,0.12);
      color:white;
      font-size:1rem;
      border:1px solid rgba(255,255,255,0.1);
    }

    .form-group textarea{
      resize:none;
      height:140px;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder{
      color:#dddddd;
    }

    .submit-btn{
      width:100%;
      padding:16px;
      border:none;
      border-radius:15px;
      background:linear-gradient(to right,#BCB9AC,#d9d4ca);
      color:#1d2731;
      font-size:1rem;
      font-weight:600;
      cursor:pointer;
      transition:0.3s;
      box-shadow:0 10px 25px rgba(0,0,0,0.2);
    }

    .submit-btn:hover{
      transform:translateY(-3px);
      box-shadow:0 15px 30px rgba(0,0,0,0.28);
    }

    /* Footer */

footer{
  width:85%;
  margin:70px auto 35px;
  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:28px;
  padding:45px 40px 20px;
  color:#f1ece2;
  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

.footer-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:35px;
}

.footer-box h2{
  font-size:2rem;
  margin-bottom:15px;
  color:#f0e7d8;
}

.footer-box h3{
  margin-bottom:18px;
  color:#ffffff;
  font-size:1.2rem;
}

.footer-box p{
  color:#dddddd;
  line-height:1.8;
  font-size:0.95rem;
}

.footer-box ul{
  list-style:none;
}

.footer-box ul li{
  margin-bottom:12px;
}

.footer-box ul li a{
  text-decoration:none;
  color:#dddddd;
  transition:0.3s;
}

.footer-box ul li a:hover{
  color:#ffffff;
  padding-left:5px;
}

.footer-bottom{
  margin-top:35px;
  padding-top:20px;
  border-top:1px solid rgba(255,255,255,0.1);
  text-align:center;
  color:#e0e0e0;
  font-size:0.95rem;
}

/* Responsive Footer */

@media(max-width:768px){

  footer{
    padding:35px 25px 20px;
  }

  .footer-container{
    gap:28px;
  }

}

    /* Popup */

    .popup{
      position:fixed;
      top:0;
      left:0;
      width:100%;
      height:100%;
      background:rgba(0,0,0,0.6);
      display:none;
      justify-content:center;
      align-items:center;
    }

    .popup-content{
      background:white;
      padding:35px;
      border-radius:20px;
      text-align:center;
      width:320px;
      color:#222;
      animation:popupShow 0.4s ease;
    }

    .popup-content h3{
      color:#2F4A61;
      margin-bottom:10px;
    }

    .popup-content button{
      margin-top:15px;
      padding:10px 25px;
      border:none;
      border-radius:10px;
      background:#2F4A61;
      color:white;
      cursor:pointer;
      font-size:1rem;
    }

    /* Slide Up Animation */

    @keyframes slideUp{
      from{
        opacity:0;
        transform:translateY(80px);
      }
      to{
        opacity:1;
        transform:translateY(0);
      }
    }

    @keyframes popupShow{
      from{
        transform:scale(0.7);
        opacity:0;
      }
      to{
        transform:scale(1);
        opacity:1;
      }
    }

    /* Responsive */

    @media(max-width:768px){

      nav{
        flex-direction:column;
        gap:20px;
        padding:20px;
      }

      nav ul{
        gap:18px;
        flex-wrap:wrap;
        justify-content:center;
      }

      .contact-container{
        padding:30px 20px;
      }

      .contact-container h1{
        font-size:2.2rem;
      }
    }

  </style>
</head>

<body>

 <!-- UPDATED NAVBAR (TOP SAME AS HOME PAGE STYLE + SEARCH BAR ADD) -->

<nav>

  <div class="logo">LuxeGift</div>

  <!-- SEARCH BAR -->

  <div class="search-box">

    <input
      type="text"
      id="searchInput"
      placeholder="Search products..."
    >

    <button onclick="searchProduct()">
      Search
    </button>

  </div>

  <ul>

    <li><a href="../website/web(gift).html">Home</a></li>

    <li><a href="../website/gift.html">Gifts</a></li>

    <li><a href="../website/accessories.html">Accessories</a></li>

    <li><a href="../website/flowers.html">Flowers</a></li>

    <li><a href="../website/cart.html">Cart</a></li>

    <li><a href="../website/login.html">Login</a></li>

  </ul>

</nav>

  <!-- Contact Section -->

  <section class="contact-section">

    <div class="contact-container">

      <h1>Contact Us</h1>

      <p>
        We'd love to hear from you. Feel free to contact LuxeGift
        for orders, support or luxury gifting assistance.
      </p>

      <form id="contactForm">

        <div class="form-group">
          <label>Full Name</label>
          <input type="text" id="name" placeholder="Enter your full name">
        </div>

        <div class="form-group">
          <label>Email Address</label>
          <input type="email" id="email" placeholder="Enter your email">
        </div>

        <div class="form-group">
          <label>Message</label>
          <textarea id="message" placeholder="Write your message"></textarea>
        </div>

        <button type="submit" class="submit-btn">
          Send Message
        </button>

      </form>

    </div>

  </section>

<!-- Footer -->

<footer>

  <div class="footer-container">

    <!-- Brand -->

    <div class="footer-box">

      <h2>LuxeGift</h2>

      <p>
        Premium luxury gifting platform crafted for unforgettable
        memories and elegant surprises.
      </p>

    </div>

    <!-- Quick Links -->

    <div class="footer-box">

      <h3>Quick Links</h3>

      <ul>
        <li><a href="../website/web(gift).html">Home</a></li>
        <li><a href="../website/gift.html">Gifts</a></li>
        <li><a href="../website/accessories.html">Accessories</a></li>
        <li><a href="../website/flowers.html">Flowers</a></li>
        <li><a href="../website/contact.html">Contact</a></li>
      </ul>

    </div>

    <!-- Customer Support -->

    <div class="footer-box">

      <h3>Customer Support</h3>

      <ul>
        <li><a href="../website/help_center.html">Help Center</a></li>
        <li><a href="../website/shipping_policy.html">Shipping Policy</a></li>
        <li><a href="../website/privacy_policy.html">Privacy Policy</a></li>
        <li><a href="../website/terms_conditions.html">Terms & Conditions</a></li>
      </ul>

    </div>

    <!-- Contact -->

    <div class="footer-box">

      <h3>Contact Us</h3>

      <p>Email: support@luxegift.com</p>

      <p>Phone: +91 98765 43210</p>

      <p>Ahmedabad, Gujarat</p>

    </div>

  </div>

  <div class="footer-bottom">

    © 2026 LuxeGift | Luxury Online Gifting Experience

  </div>

</footer>

  <!-- Popup -->

  <div class="popup" id="popup">

    <div class="popup-content">

      <h3>✨ Message Sent</h3>

      <p>Your message has been submitted successfully.</p>

      <button onclick="closePopup()">OK</button>

    </div>

  </div>

  <!-- JavaScript -->

  <script>

    document.getElementById("contactForm").addEventListener("submit", function(e){

      e.preventDefault();

      let name = document.getElementById("name").value.trim();
      let email = document.getElementById("email").value.trim();
      let message = document.getElementById("message").value.trim();

      if(name !== "" && email !== "" && message !== ""){

        document.getElementById("popup").style.display = "flex";

        document.getElementById("contactForm").reset();
      }
      else{
        alert("Please fill all fields.");
      }

    });

    function closePopup(){
      document.getElementById("popup").style.display = "none";
    }

    /* ADD SEARCH SCRIPT (BOTTOM </body> PELA) */

function searchProduct(){

  const value =
  document.getElementById(
    "searchInput"
  ).value.toLowerCase().trim();

  if(
    value.includes("watch") ||
    value.includes("perfume") ||
    value.includes("teddy") ||
    value.includes("chocolate")
  ){

    window.location.href =
    "../website/gift.html?search=" + value;

  }

  else if(
    value.includes("necklace") ||
    value.includes("ring") ||
    value.includes("earring") ||
    value.includes("anklet")
  ){

    window.location.href =
    "../website/accessories.html?search=" + value;

  }

  else if(
    value.includes("flower") ||
    value.includes("bouquet")
  ){

    window.location.href =
    "../website/flowers.html?search=" + value;

  }

  else{

    alert("Product not found");

  }

}


/* ENTER KEY SUPPORT */

document
.getElementById("searchInput")
.addEventListener("keypress",function(e){

  if(e.key === "Enter"){
    searchProduct();
  }

});

</script>
  </script>

</body>
</html>
