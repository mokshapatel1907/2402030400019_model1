<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LuxeGift Login</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

   body{
  background:
  linear-gradient(
  135deg,
  #242527 0%,
  #2F4A61 35%,
  #5F8396 65%,
  #6F6558 85%,
  #BCB9AC 100%);

  min-height:100vh;
  overflow-x:hidden;
  color:#f5f5f5;

  display:flex;
  flex-direction:column;

  padding-top:150px;
}

    body::before{
      content:'';
      position:absolute;
      width:700px;
      height:700px;
      background:rgba(188,185,172,0.12);
      border-radius:50%;
      top:-250px;
      left:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    body::after{
      content:'';
      position:absolute;
      width:650px;
      height:650px;
      background:rgba(95,131,150,0.18);
      border-radius:50%;
      bottom:-250px;
      right:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    /* ADD this CSS */

.password-box{
  position:relative;
}

.password-box input{
  width:100%;
  padding-right:50px;
}

.toggle-password{
  position:absolute;
  right:18px;
  top:50%;
  transform:translateY(-50%);
  cursor:pointer;
  font-size:1.2rem;
  color:#f0e7d8;
  user-select:none;
  transition:0.3s;
}

.toggle-password:hover{
  color:#ffffff;
}


   /* Navbar */

nav{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  width:85%;
  z-index:9999;

  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);

  padding:20px 50px;
  border-radius:25px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

/* ADD THIS CSS (NAVBAR SEARCH STYLE) */

.search-box{
  display:flex;
  align-items:center;
  gap:10px;
}

.search-box input{

  width:260px;
  padding:12px 18px;

  border:none;
  outline:none;

  border-radius:14px;

  background:rgba(255,255,255,0.08);

  border:1px solid rgba(255,255,255,0.1);

  color:#fff;

  font-size:0.95rem;

}

.search-box input::placeholder{
  color:#ddd;
}

.search-box button{

  padding:12px 20px;

  border:none;

  border-radius:14px;

  background:linear-gradient(to right,#BCB9AC,#d9d4ca);

  color:#1d2731;

  font-weight:600;

  cursor:pointer;

}

    .nav-logo{
      font-size:2.3rem;
      font-weight:700;
      color:#f0e7d8;
      letter-spacing:1px;
    }

    nav ul{
      display:flex;
      gap:40px;
      list-style:none;
    }

    nav ul li a{
      text-decoration:none;
      color:#f5f5f5;
      font-size:1rem;
      font-weight:500;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#BCB9AC;
    }

    /* Main Container */

    .main-container{
      display:flex;
      justify-content:center;
      align-items:center;
      padding:40px 20px 70px;
    }

    /* Login Box */

    .login-container{
      width:420px;
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:30px;
      padding:45px;
      box-shadow:0 10px 35px rgba(0,0,0,0.35);
      color:#fff;
      animation:fadeIn 1s ease;
    }

    @keyframes fadeIn{
      from{
        opacity:0;
        transform:translateY(30px);
      }
      to{
        opacity:1;
        transform:translateY(0);
      }
    }

    .logo{
      text-align:center;
      font-size:2.7rem;
      font-weight:700;
      color:#f0e7d8;
      margin-bottom:10px;
      letter-spacing:1px;
    }

    .subtitle{
      text-align:center;
      color:#e0e0e0;
      margin-bottom:35px;
      font-size:1rem;
    }

    .input-box{
      margin-bottom:22px;
    }

    .input-box label{
      display:block;
      margin-bottom:8px;
      color:#f1ece2;
      font-size:0.95rem;
    }

    .input-box input{
      width:100%;
      padding:14px 16px;
      border:none;
      outline:none;
      border-radius:14px;
      background:rgba(255,255,255,0.12);
      color:#fff;
      font-size:1rem;
      border:1px solid rgba(255,255,255,0.08);
    }

    .input-box input::placeholder{
      color:#d9d9d9;
    }

    /* Options */

    .options{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:25px;
      font-size:0.92rem;
    }

    .remember{
      display:flex;
      align-items:center;
      gap:8px;
      color:#f1ece2;
    }

    .forgot a{
      text-decoration:none;
      color:#f0e7d8;
      transition:0.3s;
    }

    .forgot a:hover{
      color:#ffffff;
    }

    /* Login Button */

    .login-btn{
      width:100%;
      padding:15px;
      border:none;
      border-radius:15px;
      background:linear-gradient(to right,#BCB9AC,#d9d4ca);
      color:#1d2731;
      font-size:1rem;
      font-weight:600;
      cursor:pointer;
      transition:0.3s;
      margin-bottom:25px;
    }

    .login-btn:hover{
      transform:translateY(-3px);
      box-shadow:0 10px 20px rgba(0,0,0,0.25);
    }

    /* Divider */

    .divider{
      text-align:center;
      margin:20px 0;
      color:#dddddd;
      position:relative;
    }

    .divider::before,
    .divider::after{
      content:'';
      position:absolute;
      top:50%;
      width:32%;
      height:1px;
      background:rgba(255,255,255,0.2);
    }

    .divider::before{
      left:0;
    }

    .divider::after{
      right:0;
    }

    /* Social Buttons */

    .social-login{
      display:flex;
      flex-direction:column;
      gap:16px;
    }

    .social-btn{
      width:100%;
      padding:14px;
      border:none;
      border-radius:14px;
      background:rgba(255,255,255,0.1);
      color:#fff;
      font-size:0.96rem;
      cursor:pointer;
      transition:0.3s;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
      border:1px solid rgba(255,255,255,0.08);
    }

    .social-btn:hover{
      background:rgba(255,255,255,0.16);
      transform:translateY(-2px);
    }

    .social-btn img{
      width:22px;
      height:22px;
      background:white;
      border-radius:50%;
      padding:2px;
    }

    /* Signup */

    .signup{
      text-align:center;
      margin-top:28px;
      color:#dddddd;
      font-size:0.95rem;
    }

    .signup a{
      color:#f0e7d8;
      text-decoration:none;
      font-weight:600;
    }

    .signup a:hover{
      color:#ffffff;
    }

    /* Google Popup */

    .google-popup{
      position:fixed;
      top:0;
      left:0;
      width:100%;
      height:100%;
      background:rgba(0,0,0,0.6);
      display:none;
      justify-content:center;
      align-items:center;
      z-index:9999;
      backdrop-filter:blur(8px);
    }

    .google-box{
      width:420px;
      background:white;
      border-radius:24px;
      padding:35px 30px;
      color:#202124;
      animation:popupShow 0.3s ease;
    }

    @keyframes popupShow{
      from{
        transform:scale(0.8);
        opacity:0;
      }
      to{
        transform:scale(1);
        opacity:1;
      }
    }

    .google-box h2{
      font-size:1.8rem;
      margin-bottom:8px;
    }

    .google-box p{
      color:#5f6368;
      margin-bottom:25px;
    }

    .google-account{
      display:flex;
      align-items:center;
      gap:15px;
      padding:14px;
      border-radius:14px;
      cursor:pointer;
      transition:0.3s;
      margin-bottom:15px;
    }

    .google-account:hover{
      background:#f1f3f4;
    }

    .google-account img{
      width:48px;
      height:48px;
      border-radius:50%;
    }

    .google-account h4{
      font-size:1rem;
      margin-bottom:3px;
    }

    .google-account span{
      color:#5f6368;
      font-size:0.9rem;
    }

    .close-popup{
      width:100%;
      margin-top:10px;
      padding:12px;
      border:none;
      border-radius:12px;
      background:#e8eaed;
      color:#202124;
      font-size:1rem;
      cursor:pointer;
      transition:0.3s;
    }

    .close-popup:hover{
      background:#d2d5d8;
    }

    /* Footer */

    footer{
      width:85%;
      margin:70px auto 35px;
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(20px);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:28px;
      padding:45px 40px 20px;
      color:#f1ece2;
      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    }

    .footer-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:35px;
    }

    .footer-box h2{
      font-size:2rem;
      margin-bottom:15px;
      color:#f0e7d8;
    }

    .footer-box h3{
      margin-bottom:18px;
      color:#ffffff;
      font-size:1.2rem;
    }

    .footer-box p{
      color:#dddddd;
      line-height:1.8;
      font-size:0.95rem;
    }

    .footer-box ul{
      list-style:none;
    }

    .footer-box ul li{
      margin-bottom:12px;
    }

    .footer-box ul li a{
      text-decoration:none;
      color:#dddddd;
      transition:0.3s;
    }

    .footer-box ul li a:hover{
      color:#ffffff;
      padding-left:5px;
    }

    .footer-bottom{
      margin-top:35px;
      padding-top:20px;
      border-top:1px solid rgba(255,255,255,0.1);
      text-align:center;
      color:#e0e0e0;
      font-size:0.95rem;
    }

    /* Responsive */

    @media(max-width:768px){

      nav{
        flex-direction:column;
        gap:20px;
        padding:20px;
      }

      nav ul{
        gap:18px;
        flex-wrap:wrap;
        justify-content:center;
      }
    }

    @media(max-width:500px){

      .login-container{
        width:95%;
        padding:35px 25px;
      }

      .logo{
        font-size:2.2rem;
      }

      .google-box{
        width:90%;
      }

      footer{
        padding:35px 25px 20px;
      }
    }

  </style>

</head>

