  <!-- JavaScript -->

  <script>

    const exploreButtons = document.querySelectorAll(".explore-btn");

    exploreButtons.forEach((button,index)=>{

      button.addEventListener("click",()=>{

        if(index === 0){
          window.location.href = "../website/accessories.html";
        }

        else if(index === 1){
          window.location.href = "../website/accessories.html";
        }

        else if(index === 2){
          window.location.href = "../website/gift.html";
        }

        else if(index === 3){
          window.location.href = "../website/flowers.html";
        }

        else if(index === 4){
