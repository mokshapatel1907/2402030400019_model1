<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>LuxeGift Terms & Conditions</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

   body{
  background:
  linear-gradient(
  135deg,
  #242527 0%,
  #2F4A61 35%,
  #5F8396 65%,
  #6F6558 85%,
  #BCB9AC 100%);

  min-height:100vh;
  overflow-x:hidden;
  color:#f5f5f5;

  display:flex;
  flex-direction:column;

  padding-top:150px;
}

    body::before{
      content:'';
      position:absolute;
      width:700px;
      height:700px;
      background:rgba(188,185,172,0.12);
      border-radius:50%;
      top:-250px;
      left:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    body::after{
      content:'';
      position:absolute;
      width:650px;
      height:650px;
      background:rgba(95,131,150,0.18);
      border-radius:50%;
      bottom:-250px;
      right:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    /* Navbar */

nav{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  width:85%;
  z-index:9999;

  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);

  padding:20px 50px;
  border-radius:25px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

    .logo{
      font-size:2.3rem;
      font-weight:700;
      color:#f0e7d8;
      letter-spacing:1px;
    }

    nav ul{
      display:flex;
      gap:40px;
      list-style:none;
    }

    nav ul li a{
      text-decoration:none;
      color:#f5f5f5;
      font-size:1rem;
      font-weight:500;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#BCB9AC;
    }

    /* Hero */

    .hero{
      width:85%;
      margin:20px auto 50px;

      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(20px);

      border:1px solid rgba(255,255,255,0.1);

      border-radius:30px;

      padding:70px 50px;

      text-align:center;

      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    }

    .hero h1{
      font-size:3.5rem;
      color:#f0e7d8;
      margin-bottom:20px;
      font-family:Georgia, serif;
    }

    .hero p{
      color:#dddddd;
      line-height:1.9;
      max-width:850px;
      margin:auto;
      font-size:1.08rem;
    }

    /* Terms Section */

    .terms-section{
      width:85%;
      margin:auto;
    }

    .terms-box{
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);

      border:1px solid rgba(255,255,255,0.1);

      border-radius:28px;

      padding:35px;

      margin-bottom:35px;

      box-shadow:0 8px 25px rgba(0,0,0,0.25);

      transition:0.4s;
    }

    .terms-box:hover{
      transform:translateY(-8px);
      box-shadow:0 18px 35px rgba(0,0,0,0.35);
    }

    .terms-box h2{
      color:#f0e7d8;
      margin-bottom:18px;
      font-size:1.8rem;
    }

    .terms-box p{
      color:#dddddd;
      line-height:1.9;
      font-size:1rem;
    }

    .terms-box ul{
      margin-top:18px;
      padding-left:20px;
    }

    .terms-box ul li{
      color:#dddddd;
      margin-bottom:12px;
      line-height:1.8;
    }

    /* Features */

    .terms-features{
      width:85%;
      margin:60px auto;

      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:30px;
    }

    .feature-card{
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);

      border:1px solid rgba(255,255,255,0.1);

      border-radius:26px;

      padding:35px 28px;

      text-align:center;

      box-shadow:0 8px 25px rgba(0,0,0,0.25);

      transition:0.4s;
    }

    .feature-card:hover{
      transform:translateY(-10px);
      box-shadow:0 18px 35px rgba(0,0,0,0.35);
    }

    .feature-card h3{
      color:#ffffff;
      margin-bottom:15px;
      font-size:1.5rem;
    }

    .feature-card p{
      color:#dddddd;
      line-height:1.8;
      font-size:0.96rem;
    }

    /* Footer */

    footer{
      width:85%;
      margin:70px auto 35px;

      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(20px);

      border:1px solid rgba(255,255,255,0.08);

      border-radius:28px;

      padding:45px 40px 20px;

      color:#f1ece2;

      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    }

    .footer-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:35px;
    }

    .footer-box h2{
      font-size:2rem;
      margin-bottom:15px;
      color:#f0e7d8;
    }

    .footer-box h3{
      margin-bottom:18px;
      color:#ffffff;
      font-size:1.2rem;
    }

    .footer-box p{
      color:#dddddd;
      line-height:1.8;
      font-size:0.95rem;
    }

    .footer-box ul{
      list-style:none;
    }

    .footer-box ul li{
      margin-bottom:12px;
    }

    .footer-box ul li a{
      text-decoration:none;
      color:#dddddd;
      transition:0.3s;
    }

    .footer-box ul li a:hover{
      color:#ffffff;
      padding-left:5px;
    }

    .footer-bottom{
      margin-top:35px;
      padding-top:20px;

      border-top:1px solid rgba(255,255,255,0.1);

      text-align:center;
      color:#e0e0e0;
      font-size:0.95rem;
    }

    @media(max-width:768px){

      nav{
        flex-direction:column;
        gap:20px;
        padding:20px;
      }

      nav ul{
        gap:18px;
        flex-wrap:wrap;
        justify-content:center;
      }

      .hero h1{
        font-size:2.5rem;
      }

    }

  </style>

</head>

