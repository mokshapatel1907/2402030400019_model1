  color:#ffffff;
  font-size:1.2rem;
}

.footer-box p{
  color:#dddddd;
  line-height:1.8;
  font-size:0.95rem;
}

.footer-box ul{
  list-style:none;
}

.footer-box ul li{
  margin-bottom:12px;
}

.footer-box ul li a{
  text-decoration:none;
  color:#dddddd;
  transition:0.3s;
}

.footer-box ul li a:hover{
  color:#ffffff;
  padding-left:5px;
}

.footer-bottom{
  margin-top:35px;
  padding-top:20px;
  border-top:1px solid rgba(255,255,255,0.1);
  text-align:center;
  color:#e0e0e0;
  font-size:0.95rem;
}


    @media(max-width:768px){

      nav{
        flex-direction:column;
        gap:20px;
        padding:20px;
