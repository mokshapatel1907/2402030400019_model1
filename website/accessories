  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

   body{
  background:
  linear-gradient(
  135deg,
  #242527 0%,
  #2F4A61 35%,
  #5F8396 65%,
  #6F6558 85%,
  #BCB9AC 100%);

  min-height:100vh;
  overflow-x:hidden;
  color:#f5f5f5;

  display:flex;
  flex-direction:column;

  padding-top:150px;
}

    body::before{
      content:'';
      position:absolute;
      width:700px;
      height:700px;
      background:rgba(188,185,172,0.12);
      border-radius:50%;
      top:-250px;
      left:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    body::after{
      content:'';
      position:absolute;
      width:650px;
      height:650px;
      background:rgba(95,131,150,0.18);
      border-radius:50%;
      bottom:-250px;
      right:-200px;
      z-index:-1;
      filter:blur(80px);
    }

   /* Navbar */

nav{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  width:85%;
  z-index:9999;

  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);

  padding:20px 50px;
  border-radius:25px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

    .logo{
      font-size:2.3rem;
      font-weight:700;
      color:#f0e7d8;
      letter-spacing:1px;
    }

    nav ul{
      display:flex;
      gap:40px;
      list-style:none;
    }

    nav ul li a{
      text-decoration:none;
      color:#f5f5f5;
      font-size:1rem;
      font-weight:500;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#BCB9AC;
    }

    /* Title */

    .section-title{
      text-align:center;
      font-size:3rem;
      margin-top:50px;
      margin-bottom:50px;
      color:#f1ece2;
      font-family:Georgia, serif;
    }

    /* Cards */

    .gift-container{
      width:85%;
      margin:auto;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
      gap:35px;
    }

    .gift-card{
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:28px;
      overflow:hidden;
      padding:16px;
      transition:0.4s;
      box-shadow:0 8px 25px rgba(0,0,0,0.3);
    }

    .gift-card:hover{
      transform:translateY(-10px);
      box-shadow:0 20px 35px rgba(0,0,0,0.35);
    }

    .gift-card img{
      width:100%;
      height:240px;
      object-fit:cover;
      border-radius:20px;
    }

    .gift-info{
      padding:18px 10px;
    }

    .gift-info h3{
      color:#f0e7d8;
      margin-bottom:10px;
      font-size:1.45rem;
      font-weight:600;
    }

    .gift-info p{
      color:#dddddd;
      line-height:1.8;
      margin-bottom:14px;
      font-size:0.96rem;
    }

    .price{
      font-size:1.55rem;
      font-weight:600;
      color:#ffffff;
      margin-bottom:18px;
    }

    .gift-info button{
      padding:12px 32px;
      border:none;
      border-radius:14px;
      background:linear-gradient(to right,#BCB9AC,#d9d4ca);
      color:#1d2731;
      cursor:pointer;
      transition:0.3s;
      font-size:1rem;
      font-weight:600;
    }

    .gift-info button:hover{
      transform:scale(1.05);
    }


    /* Confirm Popup */

#popup-message{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,0.45);
  display:flex;
  justify-content:center;
  align-items:center;
  opacity:0;
  visibility:hidden;
  transition:0.3s;
  z-index:9999;
}

#popup-message.show{
  opacity:1;
  visibility:visible;
}

.popup-box{
  width:350px;
  background:rgba(255,255,255,0.12);
  backdrop-filter:blur(20px);
  padding:35px;
  border-radius:25px;
  text-align:center;
  border:1px solid rgba(255,255,255,0.15);
  box-shadow:0 10px 30px rgba(0,0,0,0.35);
  color:#fff;
  animation:popupScale 0.3s ease;
}

.popup-box h2{
  margin-bottom:12px;
  color:#f0e7d8;
}

.popup-box p{
  color:#dddddd;
  margin-bottom:25px;
}

.popup-box button{
  padding:12px 35px;
  border:none;
  border-radius:12px;
  background:linear-gradient(to right,#BCB9AC,#d9d4ca);
  color:#1d2731;
  font-size:1rem;
  font-weight:600;
  cursor:pointer;
  transition:0.3s;
}

.popup-box button:hover{
  transform:scale(1.05);
}

@keyframes popupScale{
  from{
    transform:scale(0.7);
    opacity:0;
  }
  to{
    transform:scale(1);
    opacity:1;
  }
}

    /* Footer */

footer{
  width:85%;
  margin:70px auto 35px;
  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);
