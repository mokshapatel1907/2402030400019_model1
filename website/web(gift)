<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LuxeGift</title>


  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">


  <style>


    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

  body{
  background:
  linear-gradient(
  135deg,
  #242527 0%,
  #2F4A61 35%,
  #5F8396 65%,
  #6F6558 85%,
  #BCB9AC 100%);

  min-height:100vh;
  overflow-x:hidden;
  color:#f5f5f5;

  display:flex;
  flex-direction:column;

  padding-top:150px;
}

    body::before{
      content:'';
      position:absolute;
      width:700px;
      height:700px;
      background:rgba(188,185,172,0.12);
      border-radius:50%;
      top:-250px;
      left:-200px;
      z-index:-1;
      filter:blur(80px);
    }

    body::after{
      content:'';
      position:absolute;
      width:650px;
      height:650px;
      background:rgba(95,131,150,0.18);
      border-radius:50%;
      bottom:-250px;
      right:-200px;
      z-index:-1;
      filter:blur(80px);
    }



    /* Navbar */

nav{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  width:85%;
  z-index:9999;

  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);

  padding:20px 50px;
  border-radius:25px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

    .logo{
      font-size:2.3rem;
      font-weight:700;
      color:#f0e7d8;
      letter-spacing:1px;
    }

    nav ul{
      display:flex;
      gap:40px;
      list-style:none;
    }

    nav ul li a{
      text-decoration:none;
      color:#f5f5f5;
      font-size:1rem;
      font-weight:500;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#BCB9AC;
    }


    /* Hero */

    .hero{
      text-align:center;
      padding:70px 20px 40px;
    }

    .hero h1{
      font-size:4.7rem;
      line-height:1.2;
      font-family:Georgia, serif;
      margin-bottom:25px;
      color:#ffffff;
    }

    .hero h1 span{
      color:#d8d0c0;
    }

    .hero p{
      max-width:760px;
      margin:auto;
      font-size:1.2rem;
      color:#e4e4e4;
      line-height:1.9;
    }

    .hero button{
      margin-top:40px;
      padding:16px 48px;
      border:none;
      border-radius:15px;
      background:linear-gradient(to right,#BCB9AC,#d9d4ca);
      color:#1d2731;
      font-size:1rem;
      font-weight:600;
      cursor:pointer;
      transition:0.35s;
      box-shadow:0 10px 25px rgba(0,0,0,0.2);
    }

    .hero button:hover{
      transform:translateY(-4px);
    }

    /* Section Title */

    .section-title{
      text-align:center;
      margin:70px 0 45px;
      font-size:2.7rem;
      font-family:Georgia, serif;
      color:#f1ece2;
      letter-spacing:1px;
    }

    /* Gift Container */

    .gift-container{
      width:85%;
      margin:50px auto;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
      gap:40px;
      align-items:stretch;
    }

    /* Gift Card */

    .gift-card{
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:28px;
      overflow:hidden;
      padding:18px;
      transition:0.4s;
      box-shadow:0 8px 25px rgba(0,0,0,0.3);

      display:flex;
      flex-direction:column;
      justify-content:space-between;

      min-height: auto;
    }

    .gift-card:hover{
      transform:translateY(-10px);
      box-shadow:0 20px 35px rgba(0,0,0,0.35);
    }


    /* Images */


    .gift-card img{
      width:100%;
      height:250px;
      object-fit:cover;
      border-radius:22px;
      margin-bottom:20px;
    }


    /* Gift Info */

    .gift-info{
      display:flex;
      flex-direction:column;
      flex:1;
      padding:0 6px 8px;
    }

    .gift-info h3{
      color:#f0e7d8;
      margin-bottom:14px;
      font-size:1.7rem;
      font-weight:600;
      line-height:1.3;
    }

    .gift-info p{
      color:#e2e2e2;
      line-height:1.9;
      margin-bottom:22px;
      font-size:1rem;
      flex:1;
    }


    /* Footer */

footer{
  width:85%;
  margin:70px auto 35px;
  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:28px;
  padding:45px 40px 20px;
  color:#f1ece2;
  box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

.footer-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:35px;
}

.footer-box h2{
  font-size:2rem;
  margin-bottom:15px;
  color:#f0e7d8;
}

.footer-box h3{
  margin-bottom:18px;
  color:#ffffff;
  font-size:1.2rem;
}

.footer-box p{
  color:#dddddd;
  line-height:1.8;
  font-size:0.95rem;
}

.footer-box ul{
  list-style:none;
}

.footer-box ul li{
  margin-bottom:12px;
}

.footer-box ul li a{
  text-decoration:none;
  color:#dddddd;
  transition:0.3s;
}

.footer-box ul li a:hover{
  color:#ffffff;
  padding-left:5px;
}

.footer-bottom{
  margin-top:35px;
  padding-top:20px;
  border-top:1px solid rgba(255,255,255,0.1);
  text-align:center;
  color:#e0e0e0;
  font-size:0.95rem;
}

.checkout-btn a{
   text-decoration:none;
   color:#13036e;
   font-weight:600;
   font-size:1.2rem;
}


    /* Responsive */
    @media(max-width:768px){
      nav{
        flex-direction:column;
        gap:20px;
       padding:20px;
      }
      nav ul{
        gap:18px;
        flex-wrap:wrap;
        justify-content:center;
      }
      .hero h1{
        font-size:2.8rem;
      }
      .gift-container{
        grid-template-columns:1fr;
        gap:30px;
      }
      .gift-card{
        min-height:auto;
      }
      .gift-card img{
        height:230px;
      }
      footer{
        padding:35px 25px 20px;
      }
    }
  </style>
</head>


